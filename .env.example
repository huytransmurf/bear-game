# =========================================================
# SUPABASE CONFIGURATION (Cho Bảng Xếp Hạng Game Workshop)
# Lấy các thông số này tại https://app.supabase.com -> Project Settings -> API
# =========================================================

# URL Project của bạn (ví dụ: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon Public Key (Khóa công khai, an toàn cho trình duyệt Frontend)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

